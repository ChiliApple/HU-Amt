<!--
    Beispielmodul: zeigt die Bedienregeln eines Reiters (ein Satz oben, ein Hauptknopf, Dateien hineinziehen,
    fester Ergebnisordner mit "Ordner oeffnen", Zahnrad fuer Einstellungen, gruener Punkt beim Laden).
    Nur fuer Tests und Entwicklung (AddonsDev\Beispiel), wird nicht ausgeliefert.
-->
<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         x:Name="tabBeispiel" Header="&#x1F4C4; Beispiel">
    <TabItem.Resources>
        <!--HU:THEME-->
    </TabItem.Resources>
    <Grid Background="#1E1E1E" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ein Satz: was der Reiter tut -->
        <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <Button x:Name="bspBtnSettings" DockPanel.Dock="Right" Content="&#x2699; Einstellungen" Style="{StaticResource ToolButton}"
                    ToolTip="Einstellungen dieses Reiters"/>
            <TextBlock Text="Dateien hineinziehen oder auswählen - der Reiter listet sie auf (nur zum Ausprobieren)."
                       Foreground="#CCCCCC" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Ein Hauptknopf, gross und farbig -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,4,10">
            <Button x:Name="bspBtnMain" Content="&#x1F4C2; Dateien auswählen" Style="{StaticResource DarkButton}" Background="#1976D2"
                    FontSize="15" Padding="22,10" ToolTip="Dateien auswählen (oder einfach ins Fenster ziehen)"/>
            <Ellipse x:Name="bspDot" Width="10" Height="10" Fill="#4CAF50" Margin="14,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"
                     ToolTip="Wird gerade verarbeitet"/>
            <TextBlock x:Name="bspTxtStatus" Foreground="#858585" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"
                       ToolTip="Stand der letzten Verarbeitung"/>
        </StackPanel>

        <!-- Ergebnis: neueste oben -->
        <DataGrid x:Name="bspGrid" Grid.Row="2" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" Margin="4,0,4,8" ToolTip="Zuletzt übernommene Dateien (neueste oben)">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zeit" Binding="{Binding Zeit}"/>
                <DataGridTextColumn Header="Datei" Binding="{Binding Datei}"/>
                <DataGridTextColumn Header="Größe" Binding="{Binding Groesse}"/>
                <DataGridTextColumn Header="Ordner" Binding="{Binding Ordner}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Fester Ergebnisordner -->
        <DockPanel Grid.Row="3" Margin="4,0,4,4">
            <Button x:Name="bspBtnFolder" DockPanel.Dock="Right" Content="Ordner öffnen" Style="{StaticResource DarkButton}" Background="#3E3E42"
                    ToolTip="Ordner mit den Daten dieses Reiters öffnen"/>
            <TextBlock x:Name="bspTxtFolder" Foreground="#858585" FontSize="11" VerticalAlignment="Center" ToolTip="Hier legt der Reiter seine Daten ab"/>
        </DockPanel>
    </Grid>
</TabItem>
